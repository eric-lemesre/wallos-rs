onse d'erreur adopte ce format,\nsans jamais divulguer de trace d'exécution, de requête SQL ni de chemin de\nfichier (AGENTS.md §6, REQ-SEC-002).","required":["type","title","status"],"properties":{"detail":{"type":["string","null"],"description":"Explication spécifique à cette occurrence du problème."},"instance":{"type":["string","null"],"description":"URI de référence identifiant l'occurrence spécifique du problème."},"status":{"type":"integer","format":"int32","description":"Code de statut HTTP généré par l'origine.","minimum":0},"title":{"type":"string","description":"Résumé court et lisible du type de problème, stable pour un `type` donné."},"type":{"type":"string","description":"URI de référence identifiant le type de problème.","example":"about:blank"}}}}}}