{
  "name": "wallos-rs",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "frontend/api-client",
    "frontend/ui",
    "frontend/shells/web"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @wallos/shell-web",
    "build:web": "npm run build --workspace @wallos/shell-web",
    "generate:api": "npm run generate --workspace @wallos/api-client",
    "ts-types-drift": "npm run ts-types-drift --workspace @wallos/api-client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @wallos/ui"
  }
}
