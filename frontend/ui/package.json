{
  "name": "@wallos/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:api": "openapi-typescript ../../api/openapi.json --output src/api/schema.d.ts",
    "ts-types-drift": "openapi-typescript ../../api/openapi.json --output src/api/schema.d.ts && git diff --exit-code -- src/api/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.5"
  },
  "devDependencies": {
    "openapi-typescript": "^7.6.1",
    "typescript": "^5.7.3"
  }
}
